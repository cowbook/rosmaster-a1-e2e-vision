<?xml version="1.0"?>
<package format="3">
  <name>rosmaster_a1_e2e_vision</name>
  <version>0.1.0</version>
  <description>Minimal ROS 2 end-to-end visual driving MVP for Rosmaster A1 Ackermann platform.</description>
  <maintainer email="cowbook@users.noreply.github.com">cowbook</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
